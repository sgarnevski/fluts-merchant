<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="fluts-core"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        The project ruleset (ruleset.xml) without FinalLocalVariable, for flut-core only: the algorithm
        is written as plain loops with running totals, which need reassignable local variables.
        Fields, parameters, catch and pattern variables stay final there too.
    </description>

    <rule name="FinalField"
          language="java"
          message="Field ''{0}'' must be final"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>Every field is final.</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//FieldDeclaration
    [not(pmd-java:modifiers() = 'final')]
    /VariableDeclarator/VariableId
]]></value>
            </property>
        </properties>
    </rule>

    <rule name="FinalParameter"
          language="java"
          message="Parameter ''{0}'' must be final"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>Every method / constructor parameter of a method with a body is final.</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//FormalParameter
    [not(pmd-java:modifiers() = 'final')]
    [../../Block]
    /VariableId
]]></value>
            </property>
        </properties>
    </rule>

    <rule name="FinalCatchParameter"
          language="java"
          message="Catch parameter ''{0}'' must be final"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>Every catch parameter is final.</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//CatchParameter
    [not(pmd-java:modifiers() = 'final')]
    /VariableId
]]></value>
            </property>
        </properties>
    </rule>

    <rule name="FinalPatternVariable"
          language="java"
          message="Pattern variable ''{0}'' must be final"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>Every pattern variable (instanceof / switch patterns) is final.</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//TypePattern
    [not(pmd-java:modifiers() = 'final')]
    /VariableId
]]></value>
            </property>
        </properties>
    </rule>

    <rule ref="category/java/bestpractices.xml/UnusedLocalVariable"/>
    <rule ref="category/java/bestpractices.xml/UnusedPrivateField"/>
    <rule ref="category/java/bestpractices.xml/UnusedPrivateMethod"/>
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock"/>
    <rule ref="category/java/codestyle.xml/UnnecessaryImport"/>
</ruleset>
